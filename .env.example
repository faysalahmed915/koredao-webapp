# Next.js Enterprise Frontend Starter - Environment Variables
NODE_ENV=development
PORT=3001

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="NextEnterprise"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_DESCRIPTION="High-performance, secure, SEO-optimized enterprise frontend starter built with Next.js App Router, shadcn/ui, Better-Auth, and Zod."

# Backend Integration (NestJS Backend Service)
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000/api/v1"

# Better-Auth Client Configuration
# The Better-Auth server, database connection, and secret are hosted in the NestJS backend
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"
