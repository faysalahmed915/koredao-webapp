# Next.js Enterprise Frontend Starter - Environment Variables
NODE_ENV=development
PORT=3001

# Public Application Metadata
APP_NAME="KoreDao"
APP_URL="http://localhost:3001"
APP_DESCRIPTION="High-performance, secure, SEO-optimized enterprise frontend starter built with Next.js App Router, shadcn/ui, Better-Auth, and Zod."

# Backend Integration (NestJS Backend Service)
BACKEND_URL="http://localhost:3000/api/v1"

# Better-Auth Client Configuration
# The Better-Auth server, database connection, and secret are hosted in the NestJS backend
AUTH_URL="http://localhost:3000"
